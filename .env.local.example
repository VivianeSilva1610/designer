# Copie este arquivo para .env.local (no seu computador) ou cadastre as
# variáveis na Vercel em Settings → Environment Variables.

# Chave da API da Anthropic (crie em https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Senha para entrar no app. Obrigatória no site publicado: sem ela, o app fica bloqueado.
# No computador local é opcional (sem ela, a proteção fica desligada).
# Use uma senha longa (ex.: 3 ou 4 palavras aleatórias).
APP_SENHA=
